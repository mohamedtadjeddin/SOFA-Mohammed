rule CXX_SHARED_LIBRARY_LINKER__Sofa.2eComponent.2eIO.2eMesh_Release
  command = $PRE_LINK && /usr/bin/clang++-20 -fPIC $LANGUAGE_COMPILE_FLAGS $ARCH_FLAGS $LINK_FLAGS -shared $SONAME_FLAG$SONAME -o $TARGET_FILE $in $LINK_PATH $LINK_LIBRARIES && $POST_BUILD
  description = Linking CXX shared library $TARGET_FILE
  restat = $RESTAT


