  command = /usr/bin/cmake -E cmake_ninja_dyndep --tdi=Sofa/Component/IO/Mesh/CMakeFiles/Sofa.Component.IO.Mesh.dir/CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
  rspfile_content = $in


#############################################
# Rule for compiling CXX files.

rule CXX_COMPILER__Sofa.2eComponent.2eIO.2eMesh_scanned_Release
  depfile = $DEP_FILE
  deps = gcc
  command = ${LAUNCHER}${CODE_CHECK}/usr/bin/clang++-20 $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE @$DYNDEP_MODULE_MAP_FILE -o $out -c $in
  description = Building CXX object $out


#############################################
# Rule for compiling CXX files.

rule CXX_COMPILER__Sofa.2eComponent.2eIO.2eMesh_unscanned_Release
  depfile = $DEP_FILE
